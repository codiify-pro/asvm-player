{
  "name": "asvm-player",
  "productName": "ASVM Player",
  "version": "1.0.0",
  "description": "Stream online links instantly in VLC Media Player",
  "main": "main.js",
  "author": {
    "name": "AS Cinemaa"
  },
  "homepage": ".",
  "license": "MIT",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },

  "dependencies": {},

  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.asvm.player",
    "productName": "ASVM Player",

    "copyright":
      "Copyright © 2026 AS Cinemaa",

    "asar": true,

    "directories": {
      "output": "dist"
    },

    "files": [
      "**/*",
      "!dist/*",
      "!node_modules/.cache/*"
    ],

    "extraMetadata": {
      "main": "main.js"
    },

    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],

      "icon": "assets/icon.ico",

      "publisherName": "Aaryan Sah",

      "artifactName":
        "ASVM-Player-${version}.exe"
    },

    "portable": {
      "artifactName":
        "ASVM-Player.exe"
    },

    "protocols": [
      {
        "name": "ASVM Stream Protocol",
        "schemes": [
          "asvm"
        ]
      }
    ]
  }
}
